---
layout: default
---
<div class="post home-page">
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="section-kicker">Finance · Machine learning · Luxembourg</p>
      <h1 id="intro-title">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="intro-role">{{ site.data.resume.basics.label }}</p>
      <div class="intro-biography">{{ content }}</div>
      <p class="intro-connect">
        Let’s connect. <a href="mailto:{{ site.data.socials.email }}">Get in touch <span aria-hidden="true">↗</span></a>
      </p>
    </div>
    <aside class="intro-profile" aria-label="Portrait and contact links">
      <img
        class="portrait"
        src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
        width="519"
        height="563"
        alt="Alessandro Tugnetti"
        fetchpriority="high"
      >
      <div class="profile-links">
        <a href="mailto:{{ site.data.socials.email }}"><span aria-hidden="true">✉</span> Email me</a>
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
          ><span aria-hidden="true">↗</span> Google Scholar</a
        >
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/"><span aria-hidden="true">↗</span> LinkedIn</a>
      </div>
    </aside>
  </section>

  <section class="terminal-news" aria-labelledby="news-title">
    <div class="terminal-news-bar">
      <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <h2 id="news-title">~ News</h2>
      <div class="news-tabs" role="tablist" aria-label="News by year">
        {% for year in site.data.home_news %}
          <button
            type="button"
            role="tab"
            id="news-tab-{{ year.year }}"
            aria-controls="news-panel-{{ year.year }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            {{ year.year }}
          </button>
        {% endfor %}
      </div>
    </div>
    <div class="terminal-news-body">
      {% for year in site.data.home_news %}
        <div
          class="news-panel"
          id="news-panel-{{ year.year }}"
          role="tabpanel"
          aria-labelledby="news-tab-{{ year.year }}"
          tabindex="0"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <ul>
            {% for item in year.items %}
              <li>
                <time datetime="{{ item.date }}">[{{ item.label }}]</time> <span aria-hidden="true">~ $</span> {{ item.text | markdownify }}
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </section>

  <section class="home-publications" aria-labelledby="selected-title">
    <div class="section-heading">
      <h2 id="selected-title">Selected Publications</h2>
      <a href="{{ '/research/' | relative_url }}">All research <span aria-hidden="true">↗</span></a>
    </div>
    {% include selected_papers.liquid %}
  </section>

  {% include hopfield_demo.liquid %}
</div>
<script type="module" src="{{ '/assets/js/hopfield.mjs' | relative_url | bust_file_cache }}"></script>

<script type="module" src="{{ "/assets/js/news-tabs.mjs" | relative_url | bust_file_cache }}"></script>
