<div class="publications">
  {% if include.bibliography %}
    {% bibliography %}
  {% endif %}
  {% assign statuses = 'Published article|Working paper' | split: '|' %}
  {% for status in statuses %}
    {% if include.bibliography and status == 'Published article' %}{% continue %}{% endif %}
    <h2 class="bibliography">
      {% if status == 'Published article' %}Published articles{% else %}Working papers{% endif %}
    </h2>
    <ol class="bibliography">
      {% for paper in site.data.resume.publications %}
        {% if paper.status == status %}
          <li>
            <div class="row">
              <div class="col-sm-2 abbr">
                <span class="badge">
                  {%- if paper.period != '' %}{{ paper.period }}{% else %}Working paper{% endif -%}
                </span>
              </div>
              <div class="col-sm-10">
                <div class="title">
                  {% if paper.url != '' -%}
                    <a href="{{ paper.url }}">{{ paper.name }}</a>
                  {%- else -%}
                    {{- paper.name -}}
                  {%- endif %}
                </div>
                <div class="author">{{ paper.authors | linked_authors }}</div>
                <div class="periodical">
                  <em>
                    {{- paper.status -}}
                    {%- if paper.citation %} · {{ paper.citation }}{% endif -%}
                  </em>
                </div>
                <div class="research-summary">{{ paper.summary }}</div>
                {% if paper.url contains 'ssrn' %}
                  <div class="links"><a class="btn btn-sm z-depth-0" href="{{ paper.url }}">SSRN</a></div>
                {% endif %}
              </div>
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ol>
  {% endfor %}
</div>
