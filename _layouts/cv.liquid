---
layout: default
---
<div class="post public-cv">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      <a class="float-right" href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}" aria-label="Download public CV (PDF)"
        ><i class="fa-solid fa-file-pdf" aria-hidden="true"></i
      ></a>
    </h1>
  </header>
  <article>
    <div class="cv">
      <section class="card mt-3 p-3" aria-labelledby="cv-experience">
        <h2 class="card-title font-weight-medium" id="cv-experience">Experience</h2>
        {% assign displayed_work = site.data.resume.web_work | concat: site.data.resume.work %}
        {% for item in displayed_work %}
          <div class="cv-entry">
            <div class="date-column">
              <span class="badge font-weight-bold danger-color-dark">
                {%- if item.startDate %}{{ item.startDate | date: '%b %Y' }}{% else %}{{ item.period }}{% endif -%}
              </span>
            </div>
            <div class="cv-description">
              <h3>{{ item.position }}</h3>
              <p class="cv-meta">{{ item.name }}</p>
              {% if item.startDate %}
                <p>{% include adem_role.liquid kind='colleagues' %}</p>
              {% else %}
                <p>{{ item.summary }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-education">
        <h2 class="card-title font-weight-medium" id="cv-education">Education</h2>
        {% for item in site.data.resume.education %}
          <div class="cv-entry">
            <div class="date-column">
              <span class="badge font-weight-bold danger-color-dark">{{ item.period }}</span>
            </div>
            <div class="cv-description">
              <h3>
                {% if item.url -%}
                  <a href="{{ item.url }}">{{ item.studyType }}</a>
                {%- else -%}
                  {{- item.studyType -}}
                {%- endif %}
              </h3>
              <p class="cv-meta">
                {% if item.url -%}
                  <a href="{{ item.url }}">{{ item.institution }}</a>
                {%- else -%}
                  {{- item.institution -}}
                {%- endif %}
              </p>
              {% if item.summary != '' %}
                <p>{{ item.summary }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-research">
        <h2 class="card-title font-weight-medium" id="cv-research">Research</h2>
        {% include public_research.liquid cv=true %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-teaching">
        <h2 class="card-title font-weight-medium" id="cv-teaching">Teaching</h2>
        <p>University of Luxembourg. Four curricular courses, plus the Python Camp.</p>
        {% include public_teaching.liquid cv=true %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-training">
        <h2 class="card-title font-weight-medium" id="cv-training">Training &amp; Certifications</h2>
        {% for item in site.data.resume.certificates %}
          <div class="cv-entry">
            <div class="date-column">
              <span class="badge font-weight-bold danger-color-dark">{{ item.period }}</span>
            </div>
            <div class="cv-description">
              <h3>
                {% if item.url != '' -%}
                  <a href="{{ item.url }}">{{ item.name }}</a>
                {%- else -%}
                  {{- item.name -}}
                {%- endif %}
              </h3>
              <p class="cv-meta">
                {% if item.url != '' -%}
                  <a href="{{ item.url }}">{{ item.issuer }}</a>
                {%- else -%}
                  {{- item.issuer -}}
                {%- endif %}
              </p>
              {% if item.summary != '' %}
                <p>{{ item.summary }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-awards">
        <h2 class="card-title font-weight-medium" id="cv-awards">Honors, Recognition &amp; Programs</h2>
        {% for item in site.data.resume.awards %}
          <div class="cv-entry">
            <div class="date-column">
              <span class="badge font-weight-bold danger-color-dark">{{ item.period }}</span>
            </div>
            <div class="cv-description">
              <h3>
                {% if item.url -%}
                  <a href="{{ item.url }}">{{ item.title }}</a>
                {%- else -%}
                  {{- item.title -}}
                {%- endif %}
              </h3>
              <p class="cv-meta">
                {% if item.url -%}
                  <a href="{{ item.url }}">{{ item.awarder }}</a>
                {%- else -%}
                  {{- item.awarder -}}
                {%- endif %}
              </p>
              <p>{{ item.summary }}</p>
            </div>
          </div>
        {% endfor %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-volunteer">
        <h2 class="card-title font-weight-medium" id="cv-volunteer">Leadership &amp; Volunteering</h2>
        {% for item in site.data.resume.volunteer %}
          <div class="cv-entry">
            <div class="date-column">
              <span class="badge font-weight-bold danger-color-dark">{{ item.period }}</span>
            </div>
            <div class="cv-description">
              <h3>{{ item.position }}</h3>
              <p class="cv-meta">
                {% if item.url -%}
                  <a href="{{ item.url }}">{{ item.organization }}</a>
                {%- else -%}
                  {{- item.organization -}}
                {%- endif %}
              </p>
              <p>{{ item.summary }}</p>
            </div>
          </div>
        {% endfor %}
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-languages">
        <h2 class="card-title font-weight-medium" id="cv-languages">Languages</h2>
        <ul>
          {% for item in site.data.resume.languages %}
            <li>{{ item.language }}: {{ item.fluency }}</li>
          {% endfor %}
        </ul>
      </section>
      <section class="card mt-3 p-3" aria-labelledby="cv-skills">
        <h2 class="card-title font-weight-medium" id="cv-skills">Skills</h2>
        {% for item in site.data.resume.skills %}
          <p>
            <strong>{{ item.name }}:</strong> {{ item.keywords | join: ', ' }}.
          </p>
        {% endfor %}
      </section>
    </div>
  </article>
</div>
