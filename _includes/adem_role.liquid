{%- assign role = site.data.resume.web_work | first -%}
{%- assign date_label = role.startDate | date: '%-d %B %Y' -%}
{%- case include.kind -%}
  {%- when 'period' -%}
    From {{ date_label }}
  {%- when 'bio' -%}
    I work as a data scientist at {{ role.name }}, in the group of {{ role.colleagues | linked_authors }}.
  {%- when 'news' -%}
    I joined {{ role.name }} as a data scientist, in the group of {{ role.colleagues | linked_authors }}.
  {%- when 'colleagues' -%}
    Working with {{ role.colleagues | linked_authors }}.
{%- endcase -%}
