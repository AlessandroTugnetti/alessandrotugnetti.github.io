<header class="site-header">
  <nav id="navbar" class="navbar navbar-expand-md {% if site.navbar_fixed %}fixed-top{% endif %}" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand terminal-brand" href="{{ '/' | relative_url }}" aria-label="Ale Tugné at Lux, home">
        <span class="terminal-prompt">[Ale Tugné at Lux] <span aria-hidden="true">~ $</span></span>
        <span class="terminal-command" aria-hidden="true">cd /home<span class="terminal-cursor">▌</span></span>
      </a>
      <button
        class="navbar-toggler"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span aria-hidden="true">☰</span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item">
            <a
              class="nav-link {% if page.permalink == '/' %}active{% endif %}"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
              >Home</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link {% if page.permalink == '/research/' %}active{% endif %}"
              href="{{ '/research/' | relative_url }}"
              {% if page.permalink == '/research/' %}
                aria-current="page"
              {% endif %}
              >Research</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link {% if page.permalink == '/teaching/' %}active{% endif %}"
              href="{{ '/teaching/' | relative_url }}"
              {% if page.permalink == '/teaching/' %}
                aria-current="page"
              {% endif %}
              >Teaching</a
            >
          </li>
          <li class="nav-item">
            <a
              class="nav-link {% if page.permalink == '/cv/' %}active{% endif %}"
              href="{{ '/cv/' | relative_url }}"
              {% if page.permalink == '/cv/' %}
                aria-current="page"
              {% endif %}
              >CV</a
            >
          </li>
          <li class="nav-item theme-control">
            <button id="light-toggle" title="Change color theme" aria-label="Change color theme">
              <i class="ti ti-sun-moon" id="light-toggle-system"></i><i class="ti ti-moon-filled" id="light-toggle-dark"></i
              ><i class="ti ti-sun-filled" id="light-toggle-light"></i>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
