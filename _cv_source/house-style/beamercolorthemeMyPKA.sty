\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeMyPKA}[2026/08/25 myPKA Beamer colors]
\definecolor{MyPKAMutedRed}{rgb}{0.97,0.92,0.92}
\definecolor{MyPKAMutedGreen}{rgb}{0.92,0.97,0.92}
\definecolor{MyPKAMutedBlue}{rgb}{0.92,0.92,0.97}
\definecolor{MyPKAMediumRed}{rgb}{0.925,0.345,0.345}
\definecolor{MyPKAMediumGreen}{rgb}{0.37,0.7,0.66}
\definecolor{MyPKAMediumBlue}{rgb}{0.015,0.315,0.45}
\definecolor{MyPKADarkBlue}{RGB}{10,25,95}
\usecolortheme[named=MyPKADarkBlue]{structure}
\setbeamercolor{titlelike}{parent=structure}
\setbeamercolor{block title}{fg=white,bg=MyPKAMediumBlue}
\setbeamercolor{block body}{fg=black,bg=MyPKAMutedBlue}
\setbeamercolor{block title example}{fg=white,bg=MyPKAMediumGreen}
\setbeamercolor{block body example}{fg=black,bg=MyPKAMutedGreen}
\setbeamercolor{block title alerted}{fg=white,bg=MyPKAMediumRed}
\setbeamercolor{block body alerted}{fg=black,bg=MyPKAMutedRed}
\setbeamercolor{itemize item}{fg=Orange}
\setbeamercolor{itemize subitem}{fg=Orange}
\setbeamercolor{itemize subsubitem}{fg=Orange}
