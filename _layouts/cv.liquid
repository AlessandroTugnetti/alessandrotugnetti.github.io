---
layout: default
---
<div class="post public-cv">
  <header class="post-header">
    <h1 class="post-title">Curriculum vitae</h1>
    <p><a class="btn btn-sm z-depth-0" href="{{ '/assets/pdf/Tugnetti_CV.pdf' | relative_url }}">Download public CV (PDF)</a></p>
    <p>
      {{ site.data.resume.basics.name }} · {{ site.data.resume.basics.location.city }} ·
      <a href="mailto:{{ site.data.resume.basics.email }}">{{ site.data.resume.basics.email }}</a>
    </p>
    <p>{{ site.data.resume.basics.summary }}</p>
  </header>
  <article>
    <section aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      {% for item in site.data.resume.work %}
        <div class="cv-entry">
          <h3>{{ item.position }}</h3>
          <p class="cv-meta">{{ item.name }} · {{ item.period }}</p>
          <p>{{ item.summary }}</p>
        </div>
      {% endfor %}
    </section>
    <section aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      {% for item in site.data.resume.education %}
        <div class="cv-entry">
          <h3>{{ item.studyType }}</h3>
          <p class="cv-meta">{{ item.institution }} · {{ item.period }}</p>
          {% if item.summary != '' %}
            <p>{{ item.summary }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </section>
    <section aria-labelledby="cv-research">
      <h2 id="cv-research">Research</h2>
      {% include public_research.liquid %}
    </section>
    <section aria-labelledby="cv-teaching">
      <h2 id="cv-teaching">Teaching</h2>
      <p>University of Luxembourg. Four curricular courses, plus the Python Camp.</p>
      {% include public_teaching.liquid %}
    </section>
    <section aria-labelledby="cv-training">
      <h2 id="cv-training">Training &amp; Certifications</h2>
      {% for item in site.data.resume.certificates %}
        <div class="cv-entry">
          <h3>
            {% if item.url != '' -%}
              <a href="{{ item.url }}">{{ item.name }}</a>
            {%- else -%}
              {{- item.name -}}
            {%- endif %}
          </h3>
          <p class="cv-meta">{{ item.issuer }} · {{ item.period }}</p>
          {% if item.summary != '' %}
            <p>{{ item.summary }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </section>
    <section aria-labelledby="cv-awards">
      <h2 id="cv-awards">Honors, Recognition &amp; Programs</h2>
      {% for item in site.data.resume.awards %}
        <div class="cv-entry">
          <h3>{{ item.title }}</h3>
          <p class="cv-meta">{{ item.awarder }} · {{ item.period }}</p>
          <p>{{ item.summary }}</p>
        </div>
      {% endfor %}
    </section>
    <section aria-labelledby="cv-volunteer">
      <h2 id="cv-volunteer">Leadership &amp; Volunteering</h2>
      {% for item in site.data.resume.volunteer %}
        <div class="cv-entry">
          <h3>{{ item.position }}</h3>
          <p class="cv-meta">{{ item.organization }} · {{ item.period }}</p>
          <p>{{ item.summary }}</p>
        </div>
      {% endfor %}
    </section>
    <section aria-labelledby="cv-languages">
      <h2 id="cv-languages">Languages</h2>
      <ul>
        {% for item in site.data.resume.languages %}
          <li>{{ item.language }}: {{ item.fluency }}</li>
        {% endfor %}
      </ul>
    </section>
    <section aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      {% for item in site.data.resume.skills %}
        <p>
          <strong>{{ item.name }}:</strong> {{ item.keywords | join: ', ' }}.
        </p>
      {% endfor %}
    </section>
  </article>
</div>
