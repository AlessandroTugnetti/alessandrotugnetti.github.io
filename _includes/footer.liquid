<footer class="academic-footer" role="contentinfo">
  <div class="container footer-grid">
    <div class="footer-identity">
      <a class="footer-wordmark" href="{{ '/' | relative_url }}">Alessandro Tugnetti</a>
      <p>
        Finance, machine learning<br>
        and the dynamics of markets.
      </p>
      <p class="footer-copyright">
        © {{ site.time | date: '%Y' }}
        {{ site.first_name }}
        {{ site.last_name }}.
      </p>
    </div>
    <div>
      <h2>Contact</h2>
      <p>
        {{ site.data.resume.basics.location.city }}
      </p>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
    </div>
    <div>
      <h2>Find me online</h2>
      <ul>
        <li><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar ↗</a></li>
        <li><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub ↗</a></li>
        <li><a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn ↗</a></li>
        <li><a href="https://orcid.org/{{ site.data.socials.orcid_id }}">ORCID ↗</a></li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span>Built with <a href="https://jekyllrb.com/">Jekyll</a> &amp; <a href="https://github.com/alshedivat/al-folio">al-folio</a>.</span
      ><span>Visual inspiration: <a href="https://physics-morris.github.io/">Morris Huang</a></span>
    </div>
  </div>
</footer>
